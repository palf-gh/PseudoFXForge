{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PseudoFXForge definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "matchName", "controls"],
  "properties": {
    "name": { "$ref": "#/$defs/text" },
    "matchName": { "type": "string", "pattern": "^Pseudo/[A-Za-z0-9_.-]+$", "maxLength": 17 },
    "controls": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/control" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001f]+$", "description": "Non-empty text without control characters. Control names are limited to 31 UTF-8 bytes by the runtime." },
    "fixed16": { "type": "number", "minimum": -32768, "maximum": 32767.99998474121, "description": "Stored as signed 16.16 fixed-point; rounded to increments of 1/65536." },
    "vector2": { "type": "array", "items": { "$ref": "#/$defs/fixed16" }, "minItems": 2, "maxItems": 2, "default": [0, 0], "description": "Percentages of the source dimensions." },
    "vector3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3, "default": [0, 0, 0], "description": "Percentages of the source dimensions, stored as doubles." },
    "control": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$", "description": "Unique throughout the definition, including nested groups." },
        "name": { "$ref": "#/$defs/text" },
        "type": { "enum": ["slider", "angle", "checkbox", "colour", "point", "point3d", "layer", "dropdown", "label", "group"] },
        "invisible": { "type": "boolean", "default": false }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "group" } } },
          "then": {
            "required": ["children"],
            "properties": {
              "children": { "type": "array", "items": { "$ref": "#/$defs/control" } },
              "open": { "type": "boolean", "default": true }
            }
          }
        },
        {
          "if": { "properties": { "type": { "enum": ["slider", "angle", "checkbox", "colour", "point", "point3d", "layer", "dropdown"] } } },
          "then": { "properties": { "default": {}, "keyframes": { "type": "boolean" }, "hold": { "type": "boolean", "default": false } } }
        },
        {
          "if": { "properties": { "type": { "const": "slider" } } },
          "then": {
            "properties": {
              "default": { "type": "number", "default": 0 },
              "min": { "type": "number", "default": -1000000 },
              "max": { "type": "number", "default": 1000000 },
              "sliderMin": { "type": "number", "description": "Defaults to max(min, 0)." },
              "sliderMax": { "type": "number", "description": "Defaults to min(max, 100)." },
              "precision": { "type": "integer", "minimum": 0, "maximum": 6, "default": 2 },
              "unit": { "enum": ["none", "percent", "pixels"], "default": "none" }
            }
          }
        },
        { "if": { "properties": { "type": { "const": "angle" } } }, "then": { "properties": { "default": { "$ref": "#/$defs/fixed16", "default": 0 } } } },
        { "if": { "properties": { "type": { "const": "checkbox" } } }, "then": { "properties": { "default": { "type": "boolean", "default": false } } } },
        { "if": { "properties": { "type": { "const": "colour" } } }, "then": { "properties": { "default": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 }, "minItems": 3, "maxItems": 3, "default": [0, 0, 0] } } } },
        { "if": { "properties": { "type": { "const": "point" } } }, "then": { "properties": { "default": { "$ref": "#/$defs/vector2" } } } },
        { "if": { "properties": { "type": { "const": "point3d" } } }, "then": { "properties": { "default": { "$ref": "#/$defs/vector3" } } } },
        { "if": { "properties": { "type": { "const": "layer" } } }, "then": { "properties": { "default": { "enum": [0, -1], "default": 0, "description": "0 selects None; -1 selects Self." } } } },
        {
          "if": { "properties": { "type": { "const": "dropdown" } } },
          "then": {
            "required": ["items"],
            "properties": {
              "items": { "type": "array", "minItems": 1, "maxItems": 32767, "items": { "type": "string", "minLength": 1, "pattern": "^[^|\\u0000-\\u001f]+$" } },
              "default": { "type": "integer", "minimum": 1, "default": 1, "description": "Must not exceed the number of items." }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
